# Secrets — never committed, ever
.secrets/
*.env
.env.*

# Local runtime state (agent keys, run history, blob store, browser profiles)
/.nanobots/
.nanobots/

# Go
/bin/
/dist/
*.test
*.out
coverage.*

# Node / web
web/node_modules/
web/dist/
# Copied from web/dist by `make ui`; only .gitkeep is committed, so a
# fresh clone still compiles the //go:embed in internal/webui.
internal/webui/dist/*
!internal/webui/dist/.gitkeep

# Copied from bots/, examples/swarms/ and roles/roles.yaml by `make
# catalog`; only .gitkeep is committed, for the same reason.
internal/catalog/data/*
!internal/catalog/data/.gitkeep
web/*.tsbuildinfo
node_modules/
npm-debug.log*

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp

# Claude Code project state
.claude/

# gstack browse/QA reports — screenshots from a local verification pass
.gstack/

# Screenshots and page dumps from scripts/e2e — evidence for the run that
# produced them, never for the next one.
scripts/e2e/artifacts/
