{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nanobots.dev/bots/reviewer/schemas/review.json",
  "title": "Review",
  "type": "object",
  "required": ["role", "concerns", "recommendation", "one_line"],
  "properties": {
    "role": { "type": "string" },
    "concerns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["issue", "severity", "why"],
        "properties": {
          "issue": { "type": "string" },
          "severity": { "type": "string", "enum": ["blocker", "major", "minor"] },
          "why": { "type": "string" }
        }
      }
    },
    "recommendation": { "type": "string", "enum": ["ship", "ship-with-changes", "do-not-ship"] },
    "one_line": { "type": "string" }
  }
}
